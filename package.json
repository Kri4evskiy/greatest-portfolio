{
  "name": "greatest-portfolio",
  "version": "0.10.0",
  "private": true,
  "description": "Senior Full-Stack Portfolio & Protected Engineering Knowledge Base",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "build:pnpm": "pnpm -r build",
    "clean-cache": "node scripts/clean-cache.mjs",
    "dev": "node scripts/dev-runner.mjs",
    "dev:turbo": "turbo run dev",
    "dev:pnpm": "pnpm --filter @repo/web --filter @repo/api --filter @repo/telemetry-ms --parallel dev",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:ui": "vitest --ui --coverage --api.port=5124",
    "test:e2e": "pnpm --filter @repo/web test:e2e",
    "typecheck": "turbo run typecheck",
    "typecheck:pnpm": "pnpm -r typecheck",
    "setup": "node scripts/bootstrap-env.mjs",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.1",
    "@vitest/ui": "^5.1.1",
    "lefthook": "^2.2.2",
    "turbo": "^2.11.13",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
