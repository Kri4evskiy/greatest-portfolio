# ==============================================================================
# 🗄️ DATABASE (Neon.tech Serverless PostgreSQL or Local Docker Postgres)
# ==============================================================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/workfolio_db?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/workfolio_db?schema=public"

# ==============================================================================
# 🔐 BACKEND SECURITY & RBAC (apps/api)
# ==============================================================================
PORT=4000
JWT_SECRET="workfolio-super-secret-jwt-key-2026"
ADMIN_SECRET_PASSCODE="workfolio-admin-2026"
WEB_ORIGIN="http://localhost:3000"

# ==============================================================================
# 📡 MICROSERVICE TELEMETRY (apps/telemetry-ms)
# ==============================================================================
TELEMETRY_MS_HOST="127.0.0.1"
TELEMETRY_MS_PORT=4001

# ==============================================================================
# ⚡ FRONTEND & BUNDLE OPTIMIZATION (apps/web)
# ==============================================================================
API_INTERNAL_URL="http://localhost:4000"
ENABLE_REDACT="false"
ANALYZE="false"

# ==============================================================================
# 📊 OBSERVABILITY (Sentry & PostHog — Graceful No-Op when empty)
# ==============================================================================
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"
