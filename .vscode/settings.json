{
  "editor.rulers": [120],
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "biomejs.biome",
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "eslint.enable": false,
  "[javascript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[json]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[css]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "editor.codeActionsOnSave": {
    "source.fixAll.biome": "explicit"
  },
  "typescript.tsdk": "node_modules/typescript/lib",
  "cSpell.words": [
    "biomejs",
    "Callout",
    "clsx",
    "corepack",
    "httponly",
    "idb",
    "keyval",
    "lefthook",
    "lucide",
    "nestjs",
    "nextjs",
    "persister",
    "posthog",
    "prisma",
    "rbac",
    "shadcn",
    "storybook",
    "tanstack",
    "turbopack",
    "turborepo",
    "typecheck",
    "webp",
    "workfolio",
    "zod",
    "zustand"
  ]
}
