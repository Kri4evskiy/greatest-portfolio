{
  "name": "greatest-portfolio",
  "version": "0.0.6",
  "private": true,
  "description": "Senior Full-Stack Portfolio (Workfolio UI) & Protected Engineering Knowledge Base",
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "bump:version": "node scripts/bump-patch-version.mjs",
    "postinstall": "pnpm --filter @repo/shared-schemas build",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "^22.13.10",
    "lefthook": "^1.11.4",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "lefthook",
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp"
    ]
  }
}
