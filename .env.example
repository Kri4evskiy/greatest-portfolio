# ==============================================================================
# 🗄️ DATABASE (Neon.tech Serverless PostgreSQL or Local Docker Postgres)
# Раскомментируйте при подключении к Neon.tech или локальному контейнеру Postgres.
# Если не задано — PrismaService мгновенно стартует в отказоустойчивом In-Memory режиме.
# ==============================================================================
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/workfolio_db?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/workfolio_db?schema=public"

# ==============================================================================
# 🔐 BACKEND SECURITY & RBAC (apps/api)
# Note (Production / Docker Compose): NODE_ENV=production enforces:
#   - JWT_SECRET must be >= 32 characters and NOT the default dev value below
#   - ADMIN_SECRET_PASSCODE must be >= 16 characters and NOT the default dev value below
#   - WORKFOLIO_DEMO_MODE must be "false" (or unset) in real cloud production
#   - TRUST_PROXY_HOPS: 2 for Vercel rewrite -> Koyeb/Render, 1 for direct Nginx/Koyeb
# ==============================================================================
PORT=4000
WORKFOLIO_DEMO_MODE="false"
TRUST_PROXY_HOPS=2
JWT_SECRET="workfolio-super-secret-jwt-key-2026"
ADMIN_SECRET_PASSCODE="workfolio-admin-2026"
WEB_ORIGIN="http://localhost:3000"

# ==============================================================================
# 📡 MICROSERVICE TELEMETRY (apps/telemetry-ms)
# ==============================================================================
TELEMETRY_MS_HOST="127.0.0.1"
TELEMETRY_MS_PORT=4001

# ==============================================================================
# ⚡ FRONTEND & BUNDLE OPTIMIZATION (apps/web)
# Note: apps/web Edge Proxy also reads JWT_SECRET and WORKFOLIO_DEMO_MODE above.
# ==============================================================================
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
API_INTERNAL_URL="http://localhost:4000"
ANALYZE="false"

# ==============================================================================
# 📊 OBSERVABILITY (Sentry & PostHog — Graceful No-Op when empty)
# ==============================================================================
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# ==============================================================================
# 🧩 OPTIONAL CLOUD INTEGRATIONS (Capability-Gated — Priority #3–#5)
# Оставляйте закомментированными до внедрения соответствующих приоритетов.
# ==============================================================================
# REDIS_URL="rediss://default:<token>@<host>.upstash.io:6379"
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# S3_BUCKET="workfolio-assets"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# TELEGRAM_BOT_TOKEN=""

# ==============================================================================
# 🐳 DOCKER COMPOSE LOCAL HOST PORTS (Optional overrides for docker-compose.yml)
# Раскомментируйте только если локальный порт (например 5432) уже занят на хосте.
# Все порты привязаны строго к 127.0.0.1 (loopback-only).
# ==============================================================================
# POSTGRES_HOST_PORT=5432
# API_HOST_PORT=4000
# WEB_HOST_PORT=3000
