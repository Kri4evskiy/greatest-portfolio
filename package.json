{
  "name": "greatest-portfolio",
  "version": "0.3.12",
  "private": true,
  "description": "Senior Full-Stack Portfolio (Workfolio UI) & Protected Engineering Knowledge Base",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "build:pnpm": "pnpm -r build",
    "dev": "node scripts/dev-runner.mjs",
    "dev:turbo": "turbo run dev",
    "dev:pnpm": "pnpm --filter @repo/web --filter @repo/api --filter @repo/telemetry-ms --parallel dev",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "typecheck:pnpm": "pnpm -r typecheck",
    "bump:version": "node scripts/bump-patch-version.mjs",
    "setup": "node scripts/bootstrap-env.mjs",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "^22.13.10",
    "lefthook": "^2.2.2",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  }
}
