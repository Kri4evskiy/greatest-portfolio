# ============================================================================
# Greatest Portfolio & Engineering Knowledge Base — Environment Variables
# ============================================================================

# 1. PostgreSQL / Neon.tech Serverless Database (ADR #12)
# Leave empty in local dev to use automatic pre-seeded In-Memory store,
# or provide your Neon.tech / local Docker PostgreSQL connection string:
DATABASE_URL="postgresql://portfolio:portfolio_secret_password@localhost:5432/greatest_portfolio?schema=public"

# 2. NestJS Backend Security & RBAC (ADR #10, #11)
API_PORT=4000
JWT_SECRET="greatest-portfolio-dev-jwt-secret-key-2026"
ADMIN_SECRET_PASSCODE="workfolio-admin-2026"
CORS_ORIGIN="http://localhost:3000"

# 3. Telemetry Microservice TCP Bus (ADR #13)
TELEMETRY_MS_HOST="127.0.0.1"
TELEMETRY_MS_PORT=4001

# 4. Next.js Frontend & Experimental TanStack Redact (ADR #3, #8)
NEXT_PUBLIC_API_ORIGIN="http://localhost:4000"
ENABLE_REDACT="false"

# 5. Observability: Sentry & PostHog (ADR #15)
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"
